# Ganti dengan URL backend kamu (tanpa trailing slash) — WAJIB SAMA dengan
# backend yang dipakai Android agar web & Android memakai database yang sama.
# Contoh: https://abcd-1234.ngrok-free.app
#
# Android: build dengan flag yang sama, contoh:
#   flutter run --dart-define=API_URL=https://abcd-1234.ngrok-free.app
# (Untuk Android emulator lokal tanpa flag: backend default-nya http://10.0.2.2:8000,
#  web default-nya http://127.0.0.1:8000 — keduanya menunjuk host yang sama.)
VITE_API_BASE_URL=https://wriggly-diffusion-flatfoot.ngrok-free.dev
